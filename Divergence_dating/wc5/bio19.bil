ØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØ@␀A␀D␀A␀B␀C␀D␀D␀D␀E␀E␀E␀E␀E␀J␀M␀M␀N␀P␀H␀L␀N␀K␀T␀Q␀I␀L␀Q␀I␀F␀U␀U␀M␀M␀N␀K␀I␀L␀K␀I␀H␀E␀C␀?␀@␀?␀?␀?␀?␀ñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñØñ